# Copy to .env (gitignored) for local runs: `set -a; source .env; set +a`
# ci/setup_cai.py copies the Impala credentials into the CAI project environment.
COLL_IMPALA_USER=your-workload-username
COLL_IMPALA_PASSWORD=your-workload-password
HF_HOME=.hf_cache

# CAI workbench and an API v2 key (User Settings > API Keys): ci/setup_cai.py,
# cde/scripts/set_airflow_variables.py
COLL_CAI_HOST=https://federal-cml.federal.dp5i-5vkq.cloudera.site
COLL_CAI_API_KEY=

# After the CAI model is deployed (for the app's what-if tab); setup_cai.py sets the
# URL and access key in the project, and COLL_ENDPOINT_API_KEY when it is set here
# COLL_ENDPOINT_URL=https://modelservice.<workbench-domain>/model
# COLL_ENDPOINT_ACCESS_KEY=
# COLL_ENDPOINT_API_KEY=

# Cloudera Data Visualization (Admin / migration API)
COLL_CDV_URL=
COLL_CDV_API_KEY_ID=
COLL_CDV_API_KEY=
